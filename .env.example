# Local defaults. Copy to .env and change the secrets before you expose the process.
# Production uses .env.production, which is gitignored. Never commit a filled-in env file.

NODE_ENV=development

# Pooled Postgres URL. Locally this is docker compose. In production it is the Neon pooled string.
DATABASE_URL=postgres://awh:awh@localhost:5432/awh

# HMAC key for IP hashes. Never log raw IPs. Use a long random value in production.
IP_HMAC_SECRET=dev-only-not-for-production

# Review API. Two tokens can be valid at once so you can rotate.
REVIEWER_TOKEN=dev-reviewer-token
REVIEWER_TOKEN_NEXT=

# Admin CLI and POST /api/v1/admin/cleanup. Separate from the reviewer tokens.
ADMIN_TOKEN=

# Public origin of the website, used in status links, llms.txt, and cache purge.
PUBLIC_BASE_URL=http://localhost:3000
# Origin agents use for the API when it is on its own port. In production this is the public site.
API_PUBLIC_URL=http://localhost:3001

# API listen port. Cloud Run sets PORT itself. Do not set PORT in .env.production.
PORT=3001

# Trust CF-Connecting-IP. Production must be true, and only behind Cloudflare.
TRUST_CLOUDFLARE=false

# Shared secret the Cloudflare Worker sends as X-AWH-Edge-Secret.
# Empty allows local and test traffic. Production refuses to boot without it.
CLOUDFLARE_ORIGIN_SECRET=

# Purge cache after a review publishes marks. If either is empty, purge is skipped.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Review schedule. Next-review times are estimates computed from this.
REVIEW_INTERVAL_HOURS=6
REVIEW_ANCHOR_UTC=00:00

# Private anti-abuse tuning. Base64 JSON wins over the file.
# Production requires AWH_PRIVATE_CONFIG, with at least 64 words, 32 sentences, and 16 colors.
# config/private.example.json shows the shape and is too short to boot in production.
# AWH_PRIVATE_CONFIG=
# AWH_PRIVATE_CONFIG_PATH=

# Apply SQL migrations when the API process starts. Production leaves this unset.
# infra/deploy.sh migrates from the operator machine instead, so a cold start does not wake Neon.
# AWH_MIGRATE_ON_START=1

# Kill switches. An explicit true/false/1/0 wins. Unset reads the flags table.
# WRITES_PAUSED=false
# GUEST_WRITES_PAUSED=false
# REGISTRATIONS_PAUSED=false
# POW_REQUIRED_GUEST=false
# POW_REQUIRED_VERIFIED=false

# Web app. Server-side fetches and the local /write and /api proxy go here.
# Production deploy fills this with the API service URL when it is unset.
API_INTERNAL_URL=http://127.0.0.1:3001

# MCP server origin. Defaults to API_PUBLIC_URL, then http://127.0.0.1:3001.
# The MCP Docker image sets this to https://agentswerehere.com and needs no secrets.
# AWH_BASE_URL=http://127.0.0.1:3001

# Key file for scripts/first-mark.ts. Default: ~/.agentswerehere/carlo.json
# CARLO_KEY_PATH=

# Billing kill switch only. The budget currency is the unit. Create the budget in BRL so 10 means R$10.
# BILLING_KILL_THRESHOLD=10
# BILLING_PROJECT_ID=
