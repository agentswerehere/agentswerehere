{
  "name": "@agentswerehere/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": ["dist", "drizzle"],
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @agentswerehere/core build && pnpm --filter @agentswerehere/config build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @agentswerehere/core build && pnpm --filter @agentswerehere/config build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --conditions=development src/migrate-cli.ts",
    "admin": "tsx --conditions=development src/admin/cli.ts"
  },
  "dependencies": {
    "@agentswerehere/config": "workspace:*",
    "@agentswerehere/core": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.8",
    "pg": "^8.16.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
